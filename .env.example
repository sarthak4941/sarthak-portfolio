# ==========================================
# RESEND EMAIL CONFIGURATION (SERVER-SIDE ONLY)
# ==========================================
# 1. Sign up for free at https://resend.com
# 2. Generate an API Key under https://resend.com/api-keys
# 3. Copy this file to .env.local and paste your key below:
#    cp .env.example .env.local
RESEND_API_KEY=re_your_actual_api_key_here

# The verified email address that receives visitor messages:
CONTACT_RECEIVER_EMAIL=sarthakp514@gmail.com

# The sender address:
# Resend provides 'onboarding@resend.dev' for free instant testing out of the box.
# If you verify your own domain in Resend (e.g. yourdomain.com), change to e.g. "Portfolio Contact <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
